{
  "name": "compact-tools-monorepo",
  "description": "Tools for compiling, building and testing Compact smart contracts",
  "private": true,
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build --log-prefix=none",
    "test": "turbo run test --log-prefix=none",
    "coverage": "turbo run coverage --log-prefix=none",
    "test:integration": "make test-integration",
    "compile:fixtures": "make compile",
    "env:up": "make env-up",
    "env:down": "make env-down",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "lint:ci": "biome ci . --no-errors-on-unmatched",
    "types": "turbo run build types --log-prefix=none && tsc -p tests/integrations",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-beta.7",
    "@midnight-ntwrk/testkit-js": "5.0.0-beta.7",
    "@openzeppelin/compact-deployer": "workspace:^",
    "@tsconfig/node24": "24.0.3",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "5.0.0",
    "pino": "^9.7.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "resolutions": {
    "@midnightntwrk/ledger-v9": "1.0.0-rc.5",
    "glob": "^11.0.0",
    "undici": "^6.24.0",
    "uuid": "^13.0.0"
  }
}
