// SPDX-License-Identifier: Apache-2.0
// Integration-test fixture for @openzeppelin/compact-deploy.
//
// Twenty circuits: above the ~15-circuit ceiling where a single-tx deploy is
// refused with `1010 ... block limits` on midnight-node 0.22.2. Fixture for the
// Tests stage. Constructor creates no Zswap coin, so the split path accepts it.

pragma language_version >= 0.21.0;

import CompactStandardLibrary;

export ledger slot01: Counter;
export ledger slot02: Counter;
export ledger slot03: Counter;
export ledger slot04: Counter;
export ledger slot05: Counter;
export ledger slot06: Counter;
export ledger slot07: Counter;
export ledger slot08: Counter;
