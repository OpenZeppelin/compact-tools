pragma language_version >= 0.28.0;

module Pass {
  import CompactStandardLibrary;

  export struct Ticket {
    id: Bytes<32>;
  }

  export struct Receipt {
    amount: Uint<64>;
  }

  witness secretKey(): Bytes<32>;

  export circuit authenticate(salt: Bytes<32>): Ticket {
    return Ticket { id: persistentHash<Vector<2, Bytes<32>>>([salt, secretKey()]) };
  }
}
