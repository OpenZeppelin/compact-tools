{
  "name": "@openzeppelin/compact-mocker",
  "description": "Mock contract generator for Compact modules",
  "version": "0.1.0",
  "keywords": [
    "compact",
    "midnight",
    "mock",
    "testing",
    "codegen"
  ],
  "author": "OpenZeppelin Community <maintainers@openzeppelin.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenZeppelin/compact-tools.git",
    "directory": "packages/mocker"
  },
  "type": "module",
  "files": [
    "dist",
    "checksums.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "compact-mock": "dist/compactMock.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "compile:fixtures": "node test/setup.ts",
    "types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "yarn vitest run",
    "coverage": "yarn vitest run --coverage",
    "clean": "git clean -fXd"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@openzeppelin/compact-cli": "workspace:^",
    "@openzeppelin/compact-simulator": "workspace:^",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "26.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@openzeppelin/compact-launcher": "workspace:^"
  }
}
