// Sample contract for testing
// DO NOT USE IN PRODUCTION!!!

pragma language_version >= 0.20.0;

import CompactStandardLibrary;

export ledger _count: Counter;
export ledger _last: Field;
export ledger _caller: ZswapCoinPublicKey;

witness wit_value(): Field;

export circuit bump(): [] {
  _count.increment(1);
}

export pure circuit add(a: Field, b: Field): Field {
  return a + b;
}

export circuit setFromWitness(): [] {
  _last = disclose(wit_value());
}

export circuit recordCaller(): [] {
  _caller = disclose(ownPublicKey());
}

// Mints a coin to the caller, so the call has a Zswap output.
export circuit mintToCaller(nonce: Bytes<32>): [] {
  mintShieldedToken(
    pad(32, "flat"),
    1,
    disclose(nonce),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(ownPublicKey()))
  );
}

// Named like simulator members. Each touches the ledger, so it stays impure.
export circuit getPublicState(): Uint<64> {
  return _count.read();
}

export circuit signers(): [] {
  _count.increment(1);
}

export circuit then(): [] {
  _count.increment(1);
}

export pure circuit toString(): Field {
  return 7 as Field;
}

// Named like a subclass field and a subclass method in FlatSimulator.ts.
export circuit labelled(): Field {
  _count.increment(1);
  return 1 as Field;
}

export circuit described(): Field {
  _count.increment(1);
  return 2 as Field;
}
