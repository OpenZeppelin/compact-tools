// Sample contract for testing
// DO NOT USE IN PRODUCTION!!!

pragma language_version >= 0.20.0;

import CompactStandardLibrary;

export struct Point {
  x: Field;
  y: Field;
}

export ledger _owner: Bytes<32>;
export ledger _values: Vector<2, Field>;
export ledger _origin: Point;
export ledger _secret: Field;
export ledger _count: Field;

// One witness per part: a module witness and an authenticator witness.
witness wit_count(): Field;
witness wit_secret(): Field;

// The last argument is a struct, shaped like an options object.
constructor(owner: Bytes<32>, values: Vector<2, Field>, origin: Point) {
  _owner = disclose(owner);
  _values = disclose(values);
  _origin = disclose(origin);
}

export circuit storeCount(): Field {
  _count = disclose(wit_count());
  return _count;
}

export circuit storeSecret(): Field {
  _secret = disclose(wit_secret());
  return _secret;
}

export pure circuit double(x: Field): Field {
  return x + x;
}

// Named like `Function` and class statics.
export pure circuit name(): Field {
  return 1 as Field;
}

export pure circuit create(): Field {
  return 2 as Field;
}

export pure circuit then(): Field {
  return 3 as Field;
}
